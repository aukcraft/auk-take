{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default permissions for auktake desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists"
  ]
}
