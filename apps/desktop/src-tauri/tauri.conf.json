{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AukTake",
  "version": "0.1.0",
  "identifier": "org.aukcraft.auktake",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AukTake",
        "width": 1100,
        "height": 720,
        "minWidth": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
